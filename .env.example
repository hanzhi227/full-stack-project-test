# Server-side only. Fill in credentials before running the live app.
# OpenRouter: choose and verify model IDs during provider setup.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_CHAT_MODEL=
OPENROUTER_DECISION_MODEL=cloudflare/clef

# Zilliz Cloud: cluster endpoint and API key/token.
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=document_chunks_v1

# LangSmith: separate API key for tracing and evaluation.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=document-qa

# Used to sign the HTTP-only workspace cookie.
# Use an independently generated secret for each deployment.
SESSION_SIGNING_SECRET=

# Local service routing. Railway sets these per service instead.
# Frontend server: private API destination; never a NEXT_PUBLIC variable.
BACKEND_URL=http://localhost:4000
# API: permitted browser origin for mutation requests.
APP_ORIGIN=http://localhost:3000
# API port locally; frontend runs on 3000. Railway web PORT=3000, api PORT=4000.
API_PORT=4000
