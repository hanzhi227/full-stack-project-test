{
  "name": "@document-qa/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "predev": "bun run --filter @document-qa/contracts build",
    "dev": "bun --env-file=../../.env src/index.ts",
    "build": "bun run --filter @document-qa/contracts build && bun --bun tsc -p tsconfig.json",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@document-qa/contracts": "*",
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.0.0",
    "@langchain/core": "^1.2.17",
    "@langchain/textsplitters": "^1.0.2",
    "@zilliz/milvus2-sdk-node": "^2.6.0",
    "langsmith": "^0.10.8",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.0"
  },
  "type": "module"
}
